# Local app against the LIVE Production database: npm run dev:production-db
# Copy to .env.production-db and run: chmod 600 .env.production-db
# Server-side only. Never add a VITE_ prefix, never commit the copy, never use it for tests.
BARBAR_PRODUCTION_MONGODB_URI=""
# If the Atlas URI contains <db_password>, enter the database password here as-is.
# Leave empty when the URI already contains the URL-encoded password.
BARBAR_PRODUCTION_MONGODB_PASSWORD=""
BARBAR_PRODUCTION_MONGODB_DATABASE=barbar
