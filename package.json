{
  "name": "barbar-cafe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "format": "prettier --write src netlify server tests *.ts *.json *.md *.html",
    "check-format": "prettier --check src netlify server tests *.ts *.json *.md *.html",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "test:db": "BARBAR_TEST_MONGODB_URI=\"mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true\" vitest run netlify/lib/barbar-mongo.test.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.6",
    "@fontsource/playfair-display": "^5.2.6",
    "@netlify/blobs": "10.7.12",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
