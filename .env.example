# Server-side credentials only. Use different passwords, at least 12 characters each.
BARBAR_USERNAME=barbar
BARBAR_PASSWORD=
BARBAR_ADMIN_USERNAME=admin
BARBAR_ADMIN_PASSWORD=

# Local MongoDB started with npm run db:start. Atlas: replace with mongodb+srv://...
BARBAR_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
BARBAR_MONGODB_DATABASE=barbar
