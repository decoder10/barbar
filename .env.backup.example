# Copy to .env.backup, chmod 600 .env.backup. Never commit credentials or the key.
# Paste the Atlas connection string only into the ignored .env.backup file.
BARBAR_BACKUP_MONGODB_URI=""
BARBAR_BACKUP_DATABASE=barbar
BARBAR_BACKUP_KEY_FILE=/absolute/private/path/barbar.backup-key
# A SEPARATE local/isolated destination; never the production URI.
BARBAR_RESTORE_MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true"
# Scheduled runs (npm run db:backup:scheduled): a SEPARATE disk or synced folder for verified copies,
# e.g. an external drive or a Google Drive / iCloud folder. Retention applies to both locations.
BARBAR_BACKUP_DIR=.barbar-backups
BARBAR_BACKUP_MIRROR_DIR=/Volumes/BACKUP/barbar
BARBAR_BACKUP_KEEP_DAILY=7
BARBAR_BACKUP_KEEP_WEEKLY=4
